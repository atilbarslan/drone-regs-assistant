# Copy this file to .env and fill in the values. Never commit the real .env file.

# Postgres connection string. The value below matches docker-compose.yml for local development.
# In production use the Neon connection string (Neon console > Connect), which ends in
# ?sslmode=require.
DATABASE_URL=postgresql://drone:drone@localhost:5432/drone_regs

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model names, checked against https://ai.google.dev/gemini-api/docs/models on 2026-10-06.
# They live here rather than in code so they can change without a release.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# 768 rather than the default 3072: pgvector's HNSW index supports at most 2000 dimensions
# for the vector type.
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# Optional tuning; the defaults are in app/config.py.
# Embedding the sources (python -m ingest.embed) stays under these per-minute targets. Each text
# in a batch counts as one request against the requests-per-minute quota.
# EMBED_TOKENS_PER_MINUTE=25000
# EMBED_REQUESTS_PER_MINUTE=90
# EMBED_BATCH_MAX_ITEMS=20
# EMBED_BATCH_MAX_TOKENS=8000
# EMBED_MAX_RETRIES=6
# Hybrid search: candidates per list, RRF constant, results returned.
# SEARCH_CANDIDATES=30
# SEARCH_RRF_K=60
# SEARCH_TOP_K=8
